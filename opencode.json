{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orquestador",
  "permissions": [
    { "action": "read", "resource": "**/.env*", "effect": "deny" },
    { "action": "read", "resource": "**/.env.example", "effect": "allow" },
    { "action": "read", "resource": "**/.env.sample", "effect": "allow" },
    { "action": "edit", "resource": "**/.env*", "effect": "deny" },
    { "action": "read", "resource": "**/*.keystore", "effect": "deny" },
    { "action": "read", "resource": "**/google-services.json", "effect": "deny" },
    { "action": "shell", "resource": "*--force*", "effect": "ask" },
    { "action": "shell", "resource": "*supabase db push*", "effect": "ask" },
    { "action": "shell", "resource": "*supabase link*", "effect": "ask" }
  ]
}
