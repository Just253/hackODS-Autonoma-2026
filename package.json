{
  "name": "hackods",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PWA offline-first para ollas comunes del Peru (hackODS Autonoma 2026)",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/seed-local.mjs",
    "db:test": "node scripts/db-test.mjs",
    "db:types": "supabase gen types typescript --local > packages/contracts/src/db.types.ts",
    "ids:nuevo": "node scripts/nuevo-id.mjs",
    "ids:chequear": "node scripts/chequear-ids.mjs",
    "verificar": "node scripts/verificar.mjs",
    "docs:chequear": "node scripts/chequear-docs.mjs",
    "hooks:install": "node scripts/instalar-hooks.mjs",
    "arranque": "node scripts/arranque.mjs",
    "demo": "pnpm --filter @hackods/web build && pnpm --filter @hackods/web preview"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "turbo": "^2.11.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.1"
  }
}
